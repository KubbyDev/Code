export ZSH="$HOME/.oh-my-zsh"
export LANGUAGE=en_US.UTF-8
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

ZSH_THEME="mrtazz"
HYPHEN_INSENSITIVE="true"
ZSH_DISABLE_COMPFIX="true"

stty -ixon
source $ZSH/oh-my-zsh.sh

if [ "$EUID" = 0 ]
    then export PROMPT="(root) $PROMPT"
fi

export PROGRAMS="$HOME/Programs"
export PATH="$PATH:$PROGRAMS/CLion/bin"
export PATH="$PATH:$PROGRAMS/PyCharm/bin"
export EDITOR="vim"
export DOWNLOADS="$HOME/Downloads"
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/.cargo/bin"
export PATH="$PATH:/sbin"

# Aliases
alias vimrc="vim $HOME/.vimrc"
alias rc="vim $HOME/.zshrc && reload"
alias rcm="vim $HOME/.zshrc_machine_dependant && reload"
alias reload="source $HOME/.zshrc && echo 'Reloaded ZSHrc'"
alias rm='trash'
alias gl='git log --stat'
alias glo='git log --oneline'
alias glog='glo --graph HEAD origin/master'
alias glogc='glog origin/$(git branch --show-current)'
alias gs='git status'
alias gd='git diff'
alias gds='gd --staged'
alias gc='git checkout'
alias gp='git pull'
alias ip='ip -c'

# Stores all the things that will not be the same across all my machines
source $HOME/.zshrc_machine_dependant

commit() {

    if [[ -n $(git diff --name-only --cached) ]]; then
        read "response?Detected staged files. Commit as-is? [Y/n] "
        response=${response:l} #tolower
        if [[ $response =~ ^(no|n) ]]; then
            git reset HEAD .
            git add .
        fi
    else
        git add .
    fi

    git status

    # Asks the user if he wants to commit
    read "response?Commit ? [Y/n] "
    response=${response:l} #tolower
    if [[ $response =~ ^(yes|y| ) ]] || [[ -z $response ]]; then
        # Commits. Aborts if the command fails
        git commit -m $1 || return
        # Pushes
        git push -u origin HEAD
    fi
}

ccat() {
    if [[ -z "$1" ]] ; then
        echo "Please provide files to process"
        return
    fi
    for arg in "$@"; do
        echo "\n$arg:"
        pygmentize -g $arg
    done
}

_git_op() {
    local gitdir

    gitdir=$(git rev-parse --git-dir 2>/dev/null) || return 1

    if [[ -f $gitdir/MERGE_HEAD ]]; then
        echo merge
    elif [[ -d $gitdir/rebase-apply || -d $gitdir/rebase-merge ]]; then
        echo rebase
    elif [[ -f $gitdir/CHERRY_PICK_HEAD ]]; then
        echo cherry-pick
    elif [[ -f $gitdir/REVERT_HEAD ]]; then
        echo revert
    elif [[ -d $gitdir/AM ]]; then
        echo am
    else
        return 1
    fi
}

cont() {
    op=$(_git_op) || {
        echo "No continue-able git operation detected."
        return 1
    }
    echo "Continuing: git $op --continue"
    git add .
    git $op --continue
}

abort() {
    op=$(_git_op) || {
        echo "No abort-able git operation detected."
        return 1
    }
    echo "Aborting: git $op --abort"
    git $op --abort
}

